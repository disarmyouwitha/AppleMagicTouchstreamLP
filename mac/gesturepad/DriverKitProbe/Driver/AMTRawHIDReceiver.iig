#include <DriverKit/IOService.iig>
#include <DriverKit/IOUserClient.iig>
#include <DriverKit/IOTimerDispatchSource.iig>
#include <HIDDriverKit/IOHIDInterface.iig>
class AMTRawHIDReceiver : public IOService {
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;
    virtual void InputReport(uint64_t timestamp, uint32_t reportID,
        uint32_t reportLength, IOHIDReportType type, IOMemoryDescriptor *report,
        OSAction *action) TYPE(IOHIDInterface::ReportAvailable);
    virtual void Expired(OSAction *action, uint64_t time)
        TYPE(IOTimerDispatchSource::TimerOccurred);
    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient **userClient) override;
    virtual kern_return_t Handoff(uint64_t operation);
    void Publish() LOCALONLY;
    void Finish(const char *reason) LOCALONLY;
};
