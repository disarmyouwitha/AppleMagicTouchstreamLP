#pragma D option quiet
#pragma D option bufsize=8m
#pragma D option dynvarsize=2m

/* Read-only layout verified against Intel24G517 disassembly:
 * IORegistryEntry::getRegistryEntryID: *( *(this+10h) +8 ).
 * IOMemoryDescriptor::getLength: *(this+50h).
 * IOBufferMemoryDescriptor::getBytesNoCopy: flags=this+20h;
 * (flags&f0h)==20h ? *(this+b8h) : **(this+60h).
 * Restrict to the known USB completion call path and exact physical HID RID.
 */
fbt::*IOUSBHostHIDDevice21interruptReadComplete*:entry
{ self->usbActive = arg2 == 0; }
fbt::*IOUSBHostHIDDevice21interruptReadComplete*:return
{ self->usbActive = 0; }
fbt::*IOHIDDevice20handleReportWithTime*:entry
/self->usbActive && arg3 == 0 && arg2 != 0 &&
 *(uint64_t *)(arg0 + 0x10) != 0 &&
 *(uint64_t *)(*(uint64_t *)(arg0 + 0x10) + 8) == @RID@/
{
    this->report = arg2;
    this->length = *(uint64_t *)(this->report + 0x50);
    this->flags = *(uint32_t *)(this->report + 0x20);
    this->ranges = *(uint64_t *)(this->report + 0x60);
    this->buffer = (this->flags & 0xf0) == 0x20 ?
        *(uint64_t *)(this->report + 0xb8) :
        (this->ranges != 0 ? *(uint64_t *)this->ranges : 0);
    self->reportLength = this->length;
    self->reportBuffer = this->buffer;
    self->reportFlags = this->flags;
    self->dumpPending = this->length > 0 && this->length <= 64 &&
        this->buffer >= 0xffffff8000000000;
}
fbt::*IOHIDDevice20handleReportWithTime*:entry
/self->dumpPending/
{
    printf("REPORT trace_timestamp_ns=%llu unix_ns=%lld rid=@RID@ length=%llu flags=%x dump_capacity=64\n",
        timestamp, walltimestamp, self->reportLength, self->reportFlags);
    /* Only first length bytes are payload; buffer allocation is1388 bytes. */
    tracemem(self->reportBuffer, 64);
    reportCount++;
    self->dumpPending = 0;
    self->reportBuffer = 0;
}

dtrace:::BEGIN { printf("READY: original input reports for right USB pad;@DURATION@s, maximum2048 reports. Move one/two fingers.\n"); }
tick-100ms /reportCount >= 2048/ { exit(0); }
tick-@DURATION@s { exit(0); }
dtrace:::END { printf("END reports=%d\n", reportCount); }
