# /etc/udev/rules.d/90-applemagictouchstream.rules
# Grant the applemagictouchstream access group ownership of supported Apple Magic Trackpad event
# nodes, validated actuator hidraw nodes, and the AppleMagicTouchstream virtual uinput device.
# Keep uaccess as an additive desktop hint.

SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="05ac", ATTRS{id/product}=="0265", GROUP="applemagictouchstream", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="05ac", ATTRS{id/product}=="0324", GROUP="applemagictouchstream", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="004c", ATTRS{id/product}=="0265", GROUP="applemagictouchstream", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="004c", ATTRS{id/product}=="0324", GROUP="applemagictouchstream", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="0265", GROUP="applemagictouchstream", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="0324", GROUP="applemagictouchstream", MODE="0660", TAG+="uaccess"
KERNEL=="uinput", GROUP="applemagictouchstream", MODE="0660", TAG+="uaccess"
