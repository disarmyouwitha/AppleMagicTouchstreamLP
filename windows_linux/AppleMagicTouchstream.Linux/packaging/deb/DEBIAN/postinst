#!/usr/bin/env bash
set -eu

if ! getent group applemagictouchstream >/dev/null 2>&1; then
  groupadd --system applemagictouchstream || true
fi

if command -v udevadm >/dev/null 2>&1; then
  udevadm control --reload-rules || true
  udevadm trigger || true
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
fi

cat <<'EOF'
AppleMagicTouchstream Linux install complete.

[After install]:
  1. Reconnect the trackpads or wait a few seconds for refreshed udev permissions on both
     `/dev/input/event*` and the Magic Trackpad actuator `/dev/hidraw*` nodes.
  2. Add the desktop user to the 'applemagictouchstream' group:
     sudo usermod -aG applemagictouchstream $USER
  3. Log out and back in so the new group membership applies.


[Usage]:
  applemagictouchstream            # start tray GUI
  applemagictouchstream start      # start headless mode
  applemagictouchstream stop       # stop headless mode

[Other Commands]:
  applemagictouchstream print-keymap
  applemagictouchstream list-devices
  applemagictouchstream bind-left [device-node-or-stable-id]
  applemagictouchstream bind-right [device-node-or-stable-id]
  applemagictouchstream print-udev-rules
  applemagictouchstream swap-sides
  applemagictouchstream doctor

EOF
