<Window x:Class="AppleMagicTouchstream.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AppleMagicTouchstream"
        Title="AppleMagicTouchstream" Height="780" Width="1240" MinWidth="900" MinHeight="520"
        Background="#101214">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="WorkspaceVisibility" />
    <Style x:Key="GestureNavigationItemStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="NavigationChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavigationChrome" Property="Background" Value="#203746" /><Setter TargetName="NavigationChrome" Property="BorderBrush" Value="#496172" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavigationChrome" Property="Background" Value="#1b2934" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavigationChrome" Property="BorderBrush" Value="#6eb4df" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#cfd7dc" /><Setter Property="Padding" Value="0,2" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="SwitchFocus" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <DockPanel LastChildFill="True">
            <Grid Width="28" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
              <Border x:Name="SwitchTrack" Background="#3b4c59" CornerRadius="8" />
              <Ellipse x:Name="SwitchKnob" Width="12" Height="12" Margin="2" Fill="#e7e9ea" HorizontalAlignment="Left" />
            </Grid>
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
          </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="#327caa" /><Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right" /></Trigger>
          <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="SwitchTrack" Property="Background" Value="#756540" /><Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Center" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchFocus" Property="BorderBrush" Value="#6eb4df" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#e7e9ea" /><Setter Property="Background" Value="#111821" />
      <Setter Property="BorderBrush" Value="#2f4251" /><Setter Property="CaretBrush" Value="#e7e9ea" />
      <Setter Property="Padding" Value="6,3" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#e7e9ea" /><Setter Property="Background" Value="#202e39" />
      <Setter Property="BorderBrush" Value="#3b4c59" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#304858" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#1f4a67" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#6eb4df" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#e7e9ea" /><Setter Property="Padding" Value="8,5" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="ItemChrome" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#304858" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#1f4a67" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#e7e9ea" /><Setter Property="Background" Value="#111821" />
      <Setter Property="BorderBrush" Value="#3b4c59" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border x:Name="ComboChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" />
          <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock Text="⌄" Foreground="#8fb6cf" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,2" /></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="SelectedAction" IsHitTestVisible="False" Margin="7,2,24,2" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
          <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="4,1,24,1" Background="Transparent" Foreground="{TemplateBinding Foreground}" BorderThickness="0" Padding="2,0" IsReadOnly="{TemplateBinding IsReadOnly}" />
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="#151d24" BorderBrush="#496172" BorderThickness="1" CornerRadius="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEditable" Value="True"><Setter TargetName="SelectedAction" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" /></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#6eb4df" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="GestureScopeButtonStyle" TargetType="RadioButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="ScopeBorder" Background="#151d24" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="5,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="ScopeBorder" Property="Background" Value="#263e4e" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ScopeBorder" Property="BorderBrush" Value="#6eb4df" /></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScopeBorder" Property="BorderBrush" Value="#496172" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GestureSectionStyle" TargetType="Expander">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="SectionHeader" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="0,5">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="Chevron" Text="›" FontSize="17" Foreground="#8fb6cf" VerticalAlignment="Center" />
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="⌄" /></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SectionHeader" Property="BorderBrush" Value="#6eb4df" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="SectionContent" Content="{TemplateBinding Content}" Visibility="Collapsed" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True"><Setter TargetName="SectionContent" Property="Visibility" Value="Visible" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <GroupStyle x:Key="KeymapActionGroupStyle">
      <GroupStyle.HeaderTemplate>
        <DataTemplate>
          <Border Margin="6,8,6,2" Padding="8,4" CornerRadius="6" Background="#162029" BorderBrush="#2f4251" BorderThickness="1">
            <TextBlock Text="{Binding Name}" Foreground="#8fb6cf" FontSize="11" FontWeight="SemiBold" />
          </Border>
        </DataTemplate>
      </GroupStyle.HeaderTemplate>
    </GroupStyle>
    <Style x:Key="KeymapActionComboItemStyle" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style x:Key="ShortcutModifierToggleStyle" TargetType="{x:Type ToggleButton}">
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Foreground" Value="#cfd7dc" />
      <Setter Property="Background" Value="#111821" />
      <Setter Property="BorderBrush" Value="#2f4251" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Border x:Name="ShortcutToggleBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ShortcutToggleBorder" Property="Background" Value="#162431" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ShortcutToggleBorder" Property="Background" Value="#1f4a67" />
                <Setter TargetName="ShortcutToggleBorder" Property="BorderBrush" Value="#6eb4df" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WatermarkTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Foreground" Value="#e7e9ea" />
      <Setter Property="Background" Value="#111418" />
      <Setter Property="BorderBrush" Value="#2b2f33" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <Grid>
              <Border x:Name="TextBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4">
                <ScrollViewer x:Name="PART_ContentHost" />
              </Border>
              <TextBlock x:Name="Watermark"
                         Text="{TemplateBinding Tag}"
                         Foreground="#6b7279"
                         Margin="{TemplateBinding Padding}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                         IsHitTestVisible="False"
                         Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Watermark" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TextBorder" Property="BorderBrush" Value="#6eb4df" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="InspectorTabStyle" TargetType="{x:Type TabItem}">
      <Setter Property="Foreground" Value="#a8b4bd" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabItem}">
            <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Margin="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#263c4b" />
                <Setter Property="Foreground" Value="#eff6fb" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#6eb4df" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#6eb4df" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="InspectorTabsStyle" TargetType="{x:Type TabControl}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabControl}">
            <Grid KeyboardNavigation.TabNavigation="Local">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Border Background="#151d24" CornerRadius="8" Margin="8,8,8,0" Padding="2">
                <UniformGrid Rows="1" IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" />
              </Border>
              <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#14171a" Padding="12" BorderBrush="#2b2f33" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
          <StackPanel Orientation="Horizontal">
            <Border Background="#e7e9ea" CornerRadius="5" Padding="3" Margin="0,0,8,0">
              <Image x:Name="AppHandImage" Width="24" Height="24" />
            </Border>
            <TextBlock Text="AppleMagicTouchstream" Foreground="#e7e9ea" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock x:Name="RawInputErrorText" Foreground="#e74c3c" FontSize="12" TextWrapping="Wrap" MaxWidth="360" Visibility="Collapsed" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0">
          <TabControl x:Name="SettingsTabs" Width="260" SelectedIndex="1" Style="{StaticResource InspectorTabsStyle}" ItemContainerStyle="{StaticResource InspectorTabStyle}" Margin="0,0,12,0">
            <TabItem Header="_Gestures" x:Name="GestureSettingsTab" />
            <TabItem Header="_Keyboard" x:Name="KeyboardSettingsTab" />
          </TabControl>

        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Margin="16,8,16,0" Padding="12" Background="#0f1215" BorderBrush="#2b2f33" BorderThickness="1" CornerRadius="10">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,6,0"><TextBlock Text="Left Trackpad" Foreground="#8b949e" FontSize="12" Margin="0,0,0,5" /><ComboBox x:Name="LeftDeviceCombo" Height="28" /></StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,12,0"><TextBlock Text="Right Trackpad" Foreground="#8b949e" FontSize="12" Margin="0,0,0,5" /><ComboBox x:Name="RightDeviceCombo" Height="28" /></StackPanel>
          <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh" Padding="10,4" Height="28" VerticalAlignment="Bottom" />
        </Grid>
        <Expander Header="Decoder profiles" Visibility="Collapsed" Foreground="#8b949e" FontSize="11" Margin="0,9,0,0" IsExpanded="False" Style="{StaticResource GestureSectionStyle}">
          <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="LeftDecoderProfileCombo" Height="26" Margin="0,0,6,0" AutomationProperties.Name="Left decoder profile" />
            <ComboBox x:Name="RightDecoderProfileCombo" Grid.Column="1" Height="26" Margin="6,0,0,0" AutomationProperties.Name="Right decoder profile" />
          </Grid>
        </Expander>
        <WrapPanel Margin="0,9,0,0">
          <CheckBox x:Name="MouseTakeoverCheck" Content="_Mouse Takeover" Foreground="#e7e9ea" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Remembers your choice for the next launch. Ctrl+Alt+R releases and saves Off. Windows shell gestures may still run." />
          <Button x:Name="MouseTakeoverTestButton" Content="30sec test" Padding="8,3" Margin="0,0,12,0" />
          <TextBlock Text="Release: Ctrl+Alt+R" Foreground="#8fb6cf" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock x:Name="MouseTakeoverStatusText" Text="Off" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="500" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Grid x:Name="KeyboardWorkspace" Grid.Row="2" Margin="16">
      <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected, ElementName=GestureSettingsTab}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <ScrollViewer x:Name="TrackpadScrollViewer" Grid.Column="0" Margin="0,0,12,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid x:Name="TrackpadWorkspace" MinWidth="360" MinHeight="580">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <WrapPanel x:Name="ReplayPanel" VerticalAlignment="Center" Grid.Row="0" Margin="0,0,0,12" Visibility="Collapsed">
            <Button x:Name="ReplayToggleButton" Content="Play" Padding="10,4" />
            <Button x:Name="ReplayStepBackButton" Content="&#x25C0;" Width="28" Height="26" Margin="8,0,0,0" />
            <Button x:Name="ReplayStepForwardButton" Content="&#x25B6;" Width="28" Height="26" Margin="4,0,0,0" />
            <CheckBox x:Name="ReplayLoopCheckBox" Content="Loop" Foreground="#8b949e" VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBlock Text="Speed" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" Margin="10,0,6,0" />
            <ComboBox x:Name="ReplaySpeedCombo" Width="90" Height="26" />
            <Slider x:Name="ReplayTimelineSlider" Width="220" Height="22" Minimum="0" Maximum="1000" Margin="10,0,0,0" />
            <TextBlock x:Name="ReplayTimeText" Text="0.00s" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
          </WrapPanel>

          <Grid Grid.Row="2" Margin="0,12,0,0" MinHeight="260">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,6,0" Background="#0c0f12" BorderBrush="#2b2f33" BorderThickness="1" CornerRadius="12">
              <local:TouchView x:Name="LeftSurface" />
            </Border>
            <Border Grid.Column="1" Margin="6,0,0,0" Background="#0c0f12" BorderBrush="#2b2f33" BorderThickness="1" CornerRadius="12">
              <local:TouchView x:Name="RightSurface" />
            </Border>
          </Grid>
          <Border Grid.Row="3" Margin="0,12,0,0" Background="#0c0f12" BorderBrush="#2b2f33" BorderThickness="1" CornerRadius="12" Padding="12,10">
            <StackPanel Orientation="Vertical">
              <TextBlock Text="Typing Test" Foreground="#8b949e" FontSize="12" Margin="0,0,0,4" />
              <TextBox x:Name="TypingTestBox"
                        Height="72"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
      <Thumb x:Name="InspectorResizeThumb" Grid.Column="1" Cursor="SizeWE" ToolTip="Drag to resize the inspector" AutomationProperties.Name="Resize settings inspector">
        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><Border Width="2" Height="48" Background="#496172" CornerRadius="1" /></Border></ControlTemplate></Thumb.Template>
      </Thumb>
      <Border x:Name="ControlsPaneBorder" Grid.Column="2" Width="420" Background="#0c0f12" BorderBrush="#2b2f33" BorderThickness="1" CornerRadius="12">
<ScrollViewer x:Name="KeyboardSettingsScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="12">
              <StackPanel Orientation="Vertical">
                <TextBlock Text="Keyboard settings" Foreground="#e7e9ea" FontSize="14" FontWeight="SemiBold" />

                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Layout" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" />
                  <local:ExplicitSelectionComboBox x:Name="LayoutPresetCombo" Grid.Column="1" Height="26" Margin="8,0,0,0" />
                </Grid>
                <local:StenoConnectionPanel x:Name="StenoPanel" Visibility="Collapsed" />
                <Expander IsExpanded="False" Margin="0,8,0,0">
                  <Expander.Header>
                    <TextBlock Text="Column Tuning" Foreground="#8b949e" FontSize="12" />
                  </Expander.Header>
                  <StackPanel Margin="0,6,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Edit Column" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" />
                      <ComboBox x:Name="ColumnLayoutColumnCombo" Grid.Column="1" Height="24" Margin="8,0,0,0" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Column Spacing (%)" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" />
                      <TextBox x:Name="KeyPaddingBox" Grid.Column="1" Height="24" Margin="8,0,0,0" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Column Scale X (%)" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" />
                      <TextBox x:Name="ColumnScaleXBox" Grid.Column="1" Height="24" Margin="8,0,0,0" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Column Scale Y (%)" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" />
                      <TextBox x:Name="ColumnScaleYBox" Grid.Column="1" Height="24" Margin="8,0,0,0" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Column X (%)" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" />
                      <TextBox x:Name="ColumnOffsetXBox" Grid.Column="1" Height="24" Margin="8,0,0,0" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Column Y (%)" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" />
                      <TextBox x:Name="ColumnOffsetYBox" Grid.Column="1" Height="24" Margin="8,0,0,0" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Rotation (0-360 deg)" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" />
                      <TextBox x:Name="ColumnRotationBox" Grid.Column="1" Height="24" Margin="8,0,0,0" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Button x:Name="MxSpacingButton"
                              Content="mx size"
                              Height="28"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Margin="0,0,6,0" />
                      <Button x:Name="ChocSpacingButton"
                              Grid.Column="1"
                              Content="choc size"
                              Height="28"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Margin="6,0,0,0" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Button x:Name="ColumnAutoSplayButton"
                              Content="Auto Splay (4+ Fingers)"
                              Height="26"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Margin="0,0,6,0" />
                      <Button x:Name="ColumnEvenSpaceButton"
                              Grid.Column="1"
                              Content="e v e n s p a c i n g"
                              Height="26"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Margin="6,0,0,0" />
                    </Grid>
                  </StackPanel>
                </Expander>

                <Expander x:Name="KeymapEditorExpander" IsExpanded="False" Margin="0,12,0,0">
                  <Expander.Header>
                    <TextBlock Text="Keymap Tuning" Foreground="#8b949e" FontSize="12" />
                  </Expander.Header>
                  <StackPanel Margin="0,6,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Layer" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <ComboBox x:Name="LayerCombo" Grid.Row="0" Grid.Column="1" Height="26" Margin="8,0,0,0" />

                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Primary Action" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" Margin="0,8,8,0" />
                      <ComboBox x:Name="KeymapPrimaryCombo" Grid.Row="1" Grid.Column="1" Height="26" Margin="8,8,0,0" DisplayMemberPath="Display" SelectedValuePath="Value" MaxDropDownHeight="420" ItemContainerStyle="{StaticResource KeymapActionComboItemStyle}">
                        <ComboBox.GroupStyle>
                          <StaticResource ResourceKey="KeymapActionGroupStyle" />
                        </ComboBox.GroupStyle>
                      </ComboBox>

                      <TextBlock Grid.Row="2" Grid.Column="0" Text="Hold Action (optional)" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" Margin="0,8,8,0" />
                      <ComboBox x:Name="KeymapHoldCombo" Grid.Row="2" Grid.Column="1" Height="26" Margin="8,8,0,0" DisplayMemberPath="Display" SelectedValuePath="Value" MaxDropDownHeight="420" ItemContainerStyle="{StaticResource KeymapActionComboItemStyle}">
                        <ComboBox.GroupStyle>
                          <StaticResource ResourceKey="KeymapActionGroupStyle" />
                        </ComboBox.GroupStyle>
                      </ComboBox>

                      <TextBlock Grid.Row="3" Grid.Column="0" Text="Force Instead of Hold" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" Margin="0,8,8,0" />
                      <TextBox x:Name="KeymapHoldForceBox" Grid.Row="3" Grid.Column="1" Height="24" Margin="8,8,0,0" ToolTip="0 keeps timed hold. When this is above 0 and force data is present, hold fires only after this force threshold is reached." />

                      <TextBlock Grid.Row="4" Grid.Column="0" Text="Key Rotation (0-360 deg)" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" Margin="0,8,8,0" />
                      <TextBox x:Name="KeyRotationBox" Grid.Row="4" Grid.Column="1" Height="24" Margin="8,8,0,0" />
                    </Grid>
                    <Border Margin="0,12,0,0"
                            Padding="12"
                            CornerRadius="10"
                            Background="#101821"
                            BorderBrush="#2f5d78"
                            BorderThickness="1">
                      <StackPanel>
                        <TextBlock Text="Shortcut Builder"
                                   Foreground="#cfe6f5"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="GestureShortcutTargetText"
                                   Margin="0,0,0,0"
                                   Text=""
                                   Foreground="#8fb6cf"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <Grid Margin="0,10,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <RadioButton x:Name="ShortcutTargetPrimaryRadio"
                                       GroupName="ShortcutTarget"
                                       Content="Primary"
                                       Foreground="#cfe6f5"
                                       IsChecked="True"
                                        Margin="0,0,8,0" />
                          <RadioButton x:Name="ShortcutTargetHoldRadio"
                                       Grid.Column="1"
                                       GroupName="ShortcutTarget"
                                       Foreground="#cfe6f5"
                                       Content="Hold"
                                       Margin="4,0,4,0" />
                          <RadioButton x:Name="ShortcutTargetDropdownRadio"
                                       Grid.Column="2"
                                       GroupName="ShortcutTarget"
                                       Foreground="#cfe6f5"
                                       Content="Dropdown"
                                       Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <ToggleButton x:Name="GestureShortcutCtrlToggle"
                                        Content="Ctrl"
                                        Height="28"
                                        Style="{StaticResource ShortcutModifierToggleStyle}" />
                          <ToggleButton x:Name="GestureShortcutShiftToggle"
                                        Grid.Column="1"
                                        Content="Shift"
                                        Height="28"
                                        Style="{StaticResource ShortcutModifierToggleStyle}" />
                          <ToggleButton x:Name="GestureShortcutAltToggle"
                                        Grid.Column="2"
                                        Content="Alt"
                                        Height="28"
                                        Style="{StaticResource ShortcutModifierToggleStyle}" />
                          <ToggleButton x:Name="GestureShortcutWinToggle"
                                        Grid.Column="3"
                                        Content="Win"
                                        Height="28"
                                        Style="{StaticResource ShortcutModifierToggleStyle}" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0"
                                   Text="Click to toggle. Hold to choose general, left, or right. Leave Key at None for modifiers only."
                                   Foreground="#8fb6cf"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,10,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Key"
                                     Foreground="#8b949e"
                                     FontSize="12"
                                     VerticalAlignment="Center" />
                          <ComboBox x:Name="GestureShortcutKeyCombo"
                                    Grid.Column="1"
                                    Height="28"
                                    Margin="8,0,0,0"
                                    DisplayMemberPath="Display"
                                    SelectedValuePath="Value"
                                    MaxDropDownHeight="420"
                                    ItemContainerStyle="{StaticResource KeymapActionComboItemStyle}">
                            <ComboBox.GroupStyle>
                              <StaticResource ResourceKey="KeymapActionGroupStyle" />
                            </ComboBox.GroupStyle>
                          </ComboBox>
                          <Button x:Name="GestureShortcutApplyButton"
                                  Grid.Column="2"
                                  Content="Apply"
                                  Width="76"
                                  Height="28"
                                  Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="App"
                                     Foreground="#8b949e"
                                     FontSize="12"
                                     VerticalAlignment="Center" />
                          <TextBox x:Name="AppLauncherFileBox"
                                   Grid.Column="1"
                                   Height="28"
                                   Margin="8,0,0,0"
                                   VerticalContentAlignment="Center" />
                          <Button x:Name="AppLauncherBrowseButton"
                                  Grid.Column="2"
                                  Content="Browse"
                                  Width="76"
                                  Height="28"
                                  Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock x:Name="GestureShortcutPreviewText"
                                     Margin="0,0,0,0"
                                     Text="Shortcut: none"
                                     Foreground="#cfe6f5"
                                     FontSize="11"
                                     VerticalAlignment="Center"
                                     TextWrapping="Wrap" />
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Expander x:Name="CustomButtonsExpander" IsExpanded="False" Margin="0,12,0,0">
                      <Expander.Header>
                        <Border Margin="10,0,0,0"
                                Padding="8,2"
                                CornerRadius="6"
                                Background="#1A86C9A9"
                                BorderBrush="#2E4E43"
                                BorderThickness="1">
                          <TextBlock Text="Custom Buttons"
                                     Foreground="#86c9a9"
                                     FontSize="12"
                                     FontWeight="SemiBold" />
                        </Border>
                      </Expander.Header>
                      <StackPanel Margin="0,8,0,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Button x:Name="CustomButtonAddLeftButton" Content="Add Left" Height="28" Margin="0,0,6,0" />
                          <Button x:Name="CustomButtonAddRightButton" Grid.Column="1" Content="Add Right" Height="28" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="X (%)" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" />
                          <TextBox x:Name="CustomButtonXBox" Grid.Column="1" Height="24" Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Y (%)" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" />
                          <TextBox x:Name="CustomButtonYBox" Grid.Column="1" Height="24" Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Width (%)" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" />
                          <TextBox x:Name="CustomButtonWidthBox" Grid.Column="1" Height="24" Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Height (%)" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" />
                          <TextBox x:Name="CustomButtonHeightBox" Grid.Column="1" Height="24" Margin="8,0,0,0" />
                        </Grid>
                        <Button x:Name="CustomButtonDeleteButton" Content="Delete Selected Button" Height="28" Margin="0,8,0,0" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </Expander>

                <Expander IsExpanded="False" Margin="0,12,0,0">
                  <Expander.Header>
                    <TextBlock Text="Typing Tuning" Foreground="#8b949e" FontSize="12" />
                  </Expander.Header>
                  <StackPanel Margin="0,6,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Hold Duration (ms)" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" />
                      <TextBox x:Name="HoldDurationBox" Grid.Column="1" Height="24" Margin="8,0,0,0" />
                    </Grid>




                    <StackPanel x:Name="ForceTypingTuningPanel" Visibility="Collapsed">
                      <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Force Min" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                          <Slider x:Name="ForceMinSlider" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Height="22" />
                          <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="0" Foreground="#6b7279" FontSize="10" HorizontalAlignment="Left" />
                            <TextBlock x:Name="ForceMinValueText" Grid.Column="1" Foreground="#8b949e" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="255" Foreground="#6b7279" FontSize="10" HorizontalAlignment="Right" />
                          </Grid>
                        </StackPanel>
                      </Grid>
                      <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Force Max" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                          <Slider x:Name="ForceCapSlider" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Height="22" />
                          <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="0" Foreground="#6b7279" FontSize="10" HorizontalAlignment="Left" />
                            <TextBlock x:Name="ForceCapValueText" Grid.Column="1" Foreground="#8b949e" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="255" Foreground="#6b7279" FontSize="10" HorizontalAlignment="Right" />
                          </Grid>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Haptic Strength" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Slider x:Name="HapticsStrengthSlider" Minimum="0" Maximum="70" TickFrequency="1" IsSnapToTickEnabled="True" Height="22" />
                        <Grid Margin="0,2,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                        <TextBlock Text="0" Foreground="#6b7279" FontSize="10" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="70" Foreground="#6b7279" FontSize="10" HorizontalAlignment="Right" />
                        </Grid>
                      </StackPanel>
                    </Grid>
                    <Button x:Name="RestoreTypingDefaultsButton" Content="Restore Defaults" Padding="10,6" Margin="0,12,0,0" />
                  </StackPanel>
                </Expander>



                <Expander IsExpanded="True" Margin="0,12,0,0">
                  <Expander.Header>
                    <TextBlock Text="Options" Foreground="#8b949e" FontSize="12" />
                  </Expander.Header>
                  <StackPanel Margin="0,6,0,0">
                    <Grid Margin="0,0,0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <CheckBox x:Name="RunAtStartupCheck" Content="Run at Windows startup" Foreground="#8b949e" Margin="0,4,0,0" ToolTip="Launches AppleMagicTouchstream automatically when you sign in to Windows." />
                        <CheckBox x:Name="StartInTrayOnLaunchCheck" Content="Start in taskbar" Foreground="#8b949e" Margin="0,4,0,0" ToolTip="Starts AppleMagicTouchstream in the system tray without opening the config window." />
                        <CheckBox x:Name="SnapRadiusModeCheck" Content="Snap Radius" Foreground="#8b949e" Margin="0,4,0,0" ToolTip="Expands key hit detection so nearby touches snap to the closest key." />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <CheckBox x:Name="HoldRepeatModeCheck" Content="Hold Repeat" Foreground="#8b949e" Margin="0,4,0,0" ToolTip="Repeats hold-enabled key actions while you keep the touch held." />
                        <CheckBox x:Name="MemorySaverModeCheck" Content="Memory Saver" Foreground="#8b949e" Margin="0,4,0,0" ToolTip="Restarts GTK when config is closed to release memory" />
                        <CheckBox x:Name="AutocorrectModeCheck" Content="Autocorrect" Foreground="#8b949e" Margin="0,4,0,0" ToolTip="enables word correction via SymSpell" />
                      </StackPanel>
                    </Grid>
                    <UniformGrid Rows="1" Margin="0,12,0,0">
                      <Button x:Name="KeymapImportButton" Content="Import Settings" Padding="10,4" Margin="0,0,4,0" />
                      <Button x:Name="KeymapExportButton" Content="Export Settings" Padding="10,4" Margin="4,0,0,0" />
                    </UniformGrid>
                    <Border x:Name="AutocorrectStatusBorder" Visibility="Collapsed" Margin="0,8,0,0" Padding="8,6" Background="#111418" BorderBrush="#2b2f33" BorderThickness="1" CornerRadius="6">
                      <StackPanel>
                        <TextBlock Text="Autocorrect Status" Foreground="#8b949e" FontSize="11" Margin="0,0,0,4" />
                        <TextBlock Foreground="#8b949e" FontSize="11">
                          <Run Text="Last corrected: " />
                          <Run x:Name="AutocorrectLastCorrectedValueText" Text="n/a" Foreground="#e7e9ea" />
                        </TextBlock>
                        <TextBlock Foreground="#8b949e" FontSize="11" Margin="0,2,0,0">
                          <Run Text="Current buffer: " />
                          <Run x:Name="AutocorrectCurrentBufferValueText" Text="n/a" Foreground="#e7e9ea" />
                        </TextBlock>
                        <TextBlock Foreground="#8b949e" FontSize="11" Margin="0,2,0,0">
                          <Run Text="Skip reason: " />
                          <Run x:Name="AutocorrectSkipReasonValueText" Text="n/a" Foreground="#e7e9ea" />
                        </TextBlock>
                        <TextBlock Foreground="#8b949e" FontSize="11" Margin="0,2,0,0">
                          <Run Text="Reset source: " />
                          <Run x:Name="AutocorrectResetSourceValueText" Text="n/a" Foreground="#e7e9ea" />
                        </TextBlock>
                        <TextBlock Foreground="#8b949e" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap">
                          <Run Text="Recent words: " />
                          <Run x:Name="AutocorrectWordHistoryValueText" Text="n/a" Foreground="#e7e9ea" />
                        </TextBlock>
                        <TextBlock Text="Blacklist words (comma/newline)" Foreground="#8b949e" FontSize="11" Margin="0,8,0,0" />
                        <TextBox x:Name="AutocorrectBlacklistBox" Height="42" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="Always-correct map (wrong=right, comma/newline)" Foreground="#8b949e" FontSize="11" Margin="0,6,0,0" />
                        <TextBox x:Name="AutocorrectOverridesBox" Height="48" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Expander>

              </StackPanel>
            </ScrollViewer>
      </Border>
    </Grid>
    <Grid x:Name="GestureWorkspace" Grid.Row="2" Margin="16,12,16,16">
      <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected, ElementName=GestureSettingsTab}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
      <Grid x:Name="HandGesturePanelHost" />
    </Grid>
  </Grid>
</Window>
