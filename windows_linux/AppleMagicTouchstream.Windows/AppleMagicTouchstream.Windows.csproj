<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AppleMagicTouchstream</AssemblyName>
    <RootNamespace>AppleMagicTouchstream</RootNamespace>
    <Product>AppleMagicTouchstream</Product>
    <Title>AppleMagicTouchstream</Title>
    <ApplicationIcon>Assets\AppleMagicTouchstreamHand.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <Target Name="VerifyBundledJavelin" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('JavelinNative/prebuilt/win-x64/AMTJavelin.dll')" Text="Bundled Javelin DLL missing. Restore the prebuilt artifact or rebuild JavelinNative before building the complete app." />
  </Target>
  <ItemGroup>
    <Compile Remove="WindowsDiagnostics/MotionProfilesOffline/**" />
    <EmbeddedResource Include="Assets/MacTemplateSettings.json" LogicalName="AppleMagicTouchstream.MacTemplateSettings.json" />
    <EmbeddedResource Include="Assets/MacLayoutTemplates.json" LogicalName="AppleMagicTouchstream.MacLayoutTemplates.json" />
    <EmbeddedResource Include="MotionProfiles/mac-motion.json" LogicalName="AppleMagicTouchstream.mac-motion.json" />
    <EmbeddedResource Include="WindowsDiagnostics/Fixtures/AppleScrollAccelerationVectors.json" />
    <EmbeddedResource Include="WindowsDiagnostics/Fixtures/CapturedMacMotionVectors.json" />
    <EmbeddedResource Include="WindowsDiagnostics/Fixtures/RotationCountsMac.json" />
    <EmbeddedResource Include="Assets\AppleMagicTouchstreamHand.ico" />
    <EmbeddedResource Include="Assets\AppleMagicTouchstreamTrayHand.ico" />
    <Resource Include="Assets\LHS_TOUCHSTREAM_layout.png" />
    <Resource Include="Assets\RHS_TOUCHSTREAM_layout.png" />
    <EmbeddedResource Include="WindowsDiagnostics\Fixtures\ApplePointerAccelerationVectors.json" />
    <EmbeddedResource Include="WindowsDiagnostics\Fixtures\TwoFingerTapLanding.json" />
    <EmbeddedResource Include="WindowsDiagnostics\Fixtures\TwoFingerTapMovingMouse.json" />
    <EmbeddedResource Include="WindowsDiagnostics\Fixtures\FourCorners.atpcap" />
    <EmbeddedResource Include="WindowsDiagnostics/Fixtures/AppleBluetoothPacked.atpcap" LogicalName="AppleMagicTouchstream.AppleBluetoothPacked.atpcap" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AppleMagicTouchstream.Core\AppleMagicTouchstream.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets/Javelin/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="JavelinNative/prebuilt/win-x64/AMTJavelin.dll" Link="AMTJavelin.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('JavelinNative/prebuilt/win-x64/AMTJavelin.dll')" />
    <None Update="DEFAULT_KEYMAP.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="MY_KEYMAP.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Update="PloverPlugin\dist\*.whl;PloverPlugin\Install-PloverPlugin.ps1;PloverPlugin\Install-PloverPlugin.cmd;PloverPlugin\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
